# Display
ro.vendor.display.sensortype=2
vendor.display.disable_noise_layer=1
vendor.display.disable_spec_fence=1
vendor.display.enable_dcc=1000000000000
vendor.display.enable_demura=1
vendor.display.enable_hist_intr=1
vendor.display.enable_spr=1
vendor.display.enable_spr_bypass=0
vendor.display.force_lm_to_fb_config=1
vendor.display.force_tonemapping=1
vendor.display.pdfr=1
vendor.display.smomo_game_support=0
vendor.display.uir_support=1

# Radio
persist.vendor.radio.force_on_dc=true
persist.vendor.radio.virtualcomm=1

# Miscellaneous
persist.vendor.bluetooth.modem_nv_support=true
ro.build.version.svn=85
ro.config.media_vol_steps=30
ro.config.vc_call_vol_steps=9
ro.odm.build.version.sdk_full=36.1
ro.oplus.image.my_engineering.type=release
ro.product.property_source_order=odm,vendor,product,system_ext,system
ro.sys.reserve.integrate=true
ro.vendor.oplus.radio.project=1
ro.vendor.qti.va_odm.support=1
sys.oplus_ftm_mode=997
vendor.wv.oemcrypto.debug.enable_prov40=true


	chosen {
		bootargs = "log_buf_len=512K loglevel=6 cpufreq.default_governor=performance sysctl.kernel.sched_pelt_multiplier=4 no-steal-acc kpti=0 swiotlb=0 loop.max_part=7 pcie_ports=compat irqaffinity=0-2 printk.console_no_auto_verbose=1 kasan=off rcupdate.rcu_expedited=1 rcu_nocbs=0-7 kernel.panic_on_rcu_stall=1 disable_dma32=on cgroup_disable=pressure fw_devlink.strict=1 can.stats_timer=0 ftrace_dump_on_oops page_poison=on cgroup.memory=nokmem,nosocket restrict_cma_redirect=false";
		phandle = <0x2bb>;
		stdout-path = "serial0:115200n8";
	};

	cpus {
		#address-cells = <0x2>;
		#size-cells = <0x0>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1c>;
				};

				core1 {
					cpu = <0x1d>;
				};

				core2 {
					cpu = <0x1e>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x1f>;
				};

				core1 {
					cpu = <0x20>;
				};

				core2 {
					cpu = <0x21>;
				};

				core3 {
					cpu = <0x22>;
				};
			};

			cluster2 {

				core0 {
					cpu = <0x23>;
				};
			};
		};

		cpu@0 {
			#cooling-cells = <0x2>;
			capacity-dmips-mhz = <0x400>;
			compatible = "qcom,kryo";
			cpu-idle-states = <0x5 0x6>;
			device_type = "cpu";

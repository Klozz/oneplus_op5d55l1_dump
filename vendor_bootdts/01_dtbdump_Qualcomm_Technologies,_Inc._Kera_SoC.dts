					};

					mux {
						function = "gpio";
						pins = "gpio59";
					};
				};

				spkr_1_sd_n_sleep {
					phandle = <0x332>;

					config {
						bias-pull-down;
						drive-strength = <0x2>;
						input-enable;
						pins = "gpio59";

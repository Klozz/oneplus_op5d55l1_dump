			freq-table-hz = <0x5f5e100 0x18054ac0 0x0 0x0 0x0 0x0 0x5f5e100 0x18054ac0 0x5f5e100 0x18054ac0 0x0 0x0 0x0 0x0 0x0 0x0 0x0 0x0>;
			interconnect-names = "ufs-ddr", "cpu-ufs";
			interconnects = <0x80 0x34 0x48 0x201 0x81 0x2 0x82 0x220>;
			interrupts = <0x0 0x109 0x4>;
			iommus = <0x7e 0x60 0x0>;
			lanes-per-direction = <0x2>;
			memory-region = <0x83>;
			msi-parent = <0x85 0x60>;
			phandle = <0x7d>;
			phy-names = "ufsphy";
			phys = <0x7f>;
			qcom,bypass-pbl-rst-wa;
			qcom,cluster-mask = <0x3f 0xc0>;
			qcom,enforce-high-irq-cpus;
			qcom,esi-affinity-mask = <0x2 0x3 0x4 0x2 0x3 0x4 0x7 0x7>;
			qcom,ice-use-hwkm;
			qcom,iommu-dma = "fastmap";
			qcom,iommu-msi-size = <0x1000>;
			qcom,max-cpus = <0x8>;
			qcom,prime-mask = <0xc0>;
			qcom,silver-mask = <0x3f>;
			reg = <0x1d84000 0x3000 0x1d88000 0x18000 0x1da5000 0x2000 0x1da4000 0x10>;
			reg-names = "ufs_mem", "ice", "mcq_sqd", "mcq_vs";
			shared-ice-cfg = <0x84>;
			status = "disabled";

			qos0 {
				perf;
				vote = <0x2c>;
			};

			qos1 {
				vote = <0x2c>;
			};
		};

		ufshc_dma_resv_region {
			iommu-addresses = <0x7d 0x0 0x1000>;
			phandle = <0x83>;
		};

		ufsphy_mem@1d80000 {
			#phy-cells = <0x0>;
			clock-names = "ref_clk_src", "ref_aux_clk", "qref_clk", "rx_sym0_mux_clk", "rx_sym1_mux_clk", "tx_sym0_mux_clk", "rx_sym0_phy_clk", "rx_sym1_phy_clk", "tx_sym0_phy_clk";
			clocks = <0x35 0x0 0x34 0x90 0x5c 0x1 0x34 0x94 0x34 0x96 0x34 0x98 0x4e 0x4f 0x50>;
			lanes-per-direction = <0x2>;
			phandle = <0x7f>;
			reg = <0x1d80000 0x2000>;
			reg-names = "phy_mem";
			resets = <0x7d 0x0>;
			status = "disabled";
		};

		usb_audio_qmi_dev {
			compatible = "qcom,usb-audio-qmi-dev";
			iommus = <0x7e 0x100b 0x0>;
			qcom,iommu-dma = "disabled";
			qcom,usb-audio-intr-num = <0x2>;
			qcom,usb-audio-stream-id = <0xb>;
		};

		va_mini_dump {
			compatible = "qcom,va-minidump";
			memory-region = <0x6a>;
			status = "ok";
		};

		vote_lpass_audio_hw {
			#clock-cells = <0x1>;
			compatible = "qcom,audio-ref-clk";
			phandle = <0x57b>;
			qcom,codec-ext-clk-src = <0xb>;
		};

		vote_lpass_core_hw {
			#clock-cells = <0x1>;
			compatible = "qcom,audio-ref-clk";
			phandle = <0x57a>;
			qcom,codec-ext-clk-src = <0x9>;
		};

		walt {
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			ranges;

			qcom,cycle-cntr {
				compatible = "qcom,gclk";
				reg = <0x18880400 0x8 0x19880400 0x8>;
				reg-names = "freq-domain0", "freq-domain1";
			};
		};
	};
};

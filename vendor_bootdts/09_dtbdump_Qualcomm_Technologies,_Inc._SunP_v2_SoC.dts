					pins = "gpio78";
				};

				mux {
					function = "qdss_cti";
					pins = "gpio73";
				};
			};

			usb_phy_ps {
				phandle = <0x3eb>;

				usb3phy_portselect_default {
					phandle = <0x355>;

					config {
						bias-pull-down;
						drive-strength = <0x2>;
						pins = "gpio61";
					};

					mux {
						function = "usb_phy";
						pins = "gpio61";
					};
				};

				usb3phy_portselect_gpio {
					phandle = <0x3ec>;

					config {
						bias-pull-down;
						drive-strength = <0x2>;
						input-enable;
						pins = "gpio61";
					};

					mux {
						function = "gpio";
						pins = "gpio61";
					};
				};
			};

			wcd939x_reset_active {
				phandle = <0x3aa>;

				config {
					drive-strength = <0x10>;
					output-high;
					pins = "gpio101";
				};

				mux {
					function = "gpio";
					pins = "gpio101";
				};
			};

			wcd939x_reset_sleep {
				phandle = <0x3ab>;

				config {
					bias-disable;
					drive-strength = <0x10>;
					output-low;
					pins = "gpio101";
				};

				mux {
					function = "gpio";
					pins = "gpio101";
				};
			};
		};


		rsc@adc8000 {
			clocks = <0x4e 0x33>;
			compatible = "qcom,rpmh-rsc";
			interrupts = <0x0 0x170 0x4 0x0 0x171 0x4 0x0 0x172 0x4>;
			label = "cam_rsc";
			phandle = <0x35c>;
			qcom,drv-count = <0x3>;
			qcom,hw-channel;
			reg = <0xadc8000 0x1000 0xadc9000 0x1000 0xadca000 0x1000>;
			reg-names = "drv-0", "drv-1", "drv-2";

			drv@0 {
				phandle = <0x35d>;
				qcom,drv-id = <0x0>;
				qcom,tcs-distance = <0x150>;
				qcom,tcs-offset = <0x520>;

				bcm_voter {
					compatible = "qcom,bcm-voter";
					phandle = <0x88>;
					qcom,no-amc;
				};

				channel@0 {
					qcom,tcs-config = <0x2 0x0 0x1 0x1 0x0 0x1 0x3 0x0 0x4 0x0>;
				};

				channel@1 {
					qcom,tcs-config = <0x2 0x0 0x1 0x1 0x0 0x1 0x3 0x0 0x4 0x0>;
				};
			};

			drv@1 {
				phandle = <0x35e>;
				qcom,drv-id = <0x1>;
				qcom,tcs-distance = <0x150>;
				qcom,tcs-offset = <0x520>;

				bcm_voter {
					compatible = "qcom,bcm-voter";
					phandle = <0x89>;
					qcom,no-amc;
				};

				channel@0 {
					qcom,tcs-config = <0x2 0x0 0x1 0x1 0x0 0x1 0x3 0x0 0x4 0x0>;
				};

				channel@1 {
					qcom,tcs-config = <0x2 0x0 0x1 0x1 0x0 0x1 0x3 0x0 0x4 0x0>;
				};
			};

			drv@2 {
				phandle = <0x35f>;
				qcom,drv-id = <0x2>;
				qcom,tcs-distance = <0x150>;
				qcom,tcs-offset = <0x520>;

				bcm_voter {
					compatible = "qcom,bcm-voter";
					phandle = <0x8a>;
					qcom,no-amc;
				};

				channel@0 {
					qcom,tcs-config = <0x2 0x0 0x1 0x1 0x0 0x1 0x3 0x0 0x4 0x0>;
				};

				channel@1 {
					qcom,tcs-config = <0x2 0x0 0x1 0x1 0x0 0x1 0x3 0x0 0x4 0x0>;
				};
			};
		};


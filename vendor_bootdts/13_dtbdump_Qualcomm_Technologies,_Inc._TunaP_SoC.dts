			sdc2_off {
				phandle = <0x3a3>;

				clk {
					bias-disable;
					drive-strength = <0x2>;
					function = "gpio";
					pins = "gpio62";
				};

				cmd {
					bias-pull-up;
					drive-strength = <0x2>;
					function = "gpio";
					pins = "gpio51";
				};

				data {
					bias-pull-up;
					drive-strength = <0x2>;
					function = "gpio";
					pins = "gpio63", "gpio120", "gpio48", "gpio49";
				};

				sd-cd {
					bias-pull-up;
					drive-strength = <0x2>;
					pins = "gpio39";
				};
			};

			sdc2_on {
				phandle = <0x3a2>;

				clk {
					bias-disable;
					drive-strength = <0x10>;
					function = "SDC2_CLK";
					pins = "gpio62";
				};

				cmd {
					bias-pull-up;
					drive-strength = <0xa>;
					function = "SDC2_CMD";
					pins = "gpio51";
				};

				data {
					bias-pull-up;
					drive-strength = <0xa>;
					function = "SDC2_DATA";
					pins = "gpio63", "gpio120", "gpio48", "gpio49";
				};

				sd-cd {
					bias-pull-up;
					drive-strength = <0x2>;
					pins = "gpio39";
				};
			};


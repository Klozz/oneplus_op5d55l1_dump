				bcl@4700 {
					#thermal-sensor-cells = <0x1>;
					compatible = "qcom,pm8550-bcl-v5";
					interrupt-names = "bcl-lvl0", "bcl-lvl1", "bcl-lvl2";
					interrupts = <0x1 0x47 0x0 0x0 0x1 0x47 0x1 0x0 0x1 0x47 0x2 0x0>;
					phandle = <0xa6>;
					qcom,pmic7-threshold;
					reg = <0x4700 0x100>;
				};

				led-controller {
					#address-cells = <0x1>;
					#pwm-cells = <0x2>;
					#size-cells = <0x0>;
					compatible = "qcom,pm8350c-pwm";
					nvmem = <0x9f 0xa0>;
					nvmem-names = "lpg_chan_sdam", "lut_sdam";
					phandle = <0x3d6>;

					led@1 {
						color = <0x1>;
						label = "red";
						reg = <0x1>;
					};

					led@2 {
						color = <0x2>;
						label = "green";
						reg = <0x2>;
					};

					led@3 {
						color = <0x3>;
						label = "blue";
						reg = <0x3>;
					};
				};

				pinctrl@8800 {
					#gpio-cells = <0x2>;
					#interrupt-cells = <0x2>;

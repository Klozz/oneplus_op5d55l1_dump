		sdhc_2_dma_resv_region {
			iommu-addresses = <0x92 0x0 0x40000000 0x92 0x50000000 0xb0000000>;
			phandle = <0x93>;
		};

		sdhci@8804000 {
			bus-width = <0x4>;
			clock-names = "iface", "core";
			clocks = <0x3d 0x6f 0x3d 0x70>;
			compatible = "qcom,sdhci-msm-v5";
			dma-coherent;
			interconnect-names = "sdhc-ddr", "cpu-sdhc";
			interconnects = <0x94 0x30 0x28 0x200 0x27 0x2 0x95 0x216>;
			interrupt-names = "hc_irq", "pwr_irq";
			interrupts = <0x0 0xcf 0x4 0x0 0xdf 0x4>;
			iommus = <0x2f 0x140 0x0>;
			memory-region = <0x93>;
			no-mmc;
			no-sdio;
			operating-points-v2 = <0x96>;
			phandle = <0x92>;
			qcom,dll-hsr-list = <0x7442c 0x0 0x10 0x90106c0 0x80040868>;
			qcom,iommu-dma = "fastmap";
			qcom,iommu-geometry = <0x40000000 0x10000000>;
			qcom,restore-after-cx-collapse;
			reg = <0x8804000 0x1000>;
			reg-names = "hc";
			reset-names = "core_reset";
			resets = <0x3d 0x12>;
			status = "disabled";

			qos0 {
				mask = <0xf0>;
				vote = <0x2c>;
			};

			qos1 {
				mask = <0xf>;
				vote = <0x2c>;
			};
		};

		shared_ice {
			phandle = <0x9b>;

			alg1 {
				alg-name = "alg1";
				rx-alloc-percent = <0x3c>;
				status = "disabled";
			};

